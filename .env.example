# YesWeSync / Airbyte 2.2.0 — Variables d'environnement
# Copier en .env sur le Droplet avant de lancer install.sh
# AUCUN secret réel dans ce fichier Git.

# ── Infrastructure ────────────────────────────────────────────────────────────

# Version abctl à installer (ne pas changer sans validation)
ABCTL_VERSION=0.30.4

# Version Airbyte (Helm chart — ne pas changer sans validation)
AIRBYTE_VERSION=2.2.0

# URL publique d'Airbyte (domaine, avec https)
AIRBYTE_URL=https://yeswesync.VOTRE_DOMAINE.com

# Port sur lequel abctl/kind expose Airbyte sur l'hôte
AIRBYTE_PORT=8085

# Mot de passe de l'admin initial (laisser vide = Airbyte auto-génère)
AIRBYTE_INITIAL_USER_PASSWORD=CHANGE_ME

# ID d'installation unique (laisser vide = auto-généré au 1er lancement)
AIRBYTE_INSTALLATION_ID=

# Ressources max par job connecteur
AIRBYTE_JOB_CPU_LIMIT=3
AIRBYTE_JOB_MEMORY_LIMIT=4Gi

# Flags supplémentaires abctl (ex: --low-resource-mode si < 8 Go RAM)
ABCTL_EXTRA_FLAGS=

# Chemin de données abctl sur l'hôte (PVs Kubernetes)
AIRBYTE_DATA_DIR=/root/.airbyte

# ── Staging PostgreSQL ────────────────────────────────────────────────────────

# Nom du container Docker staging
STAGING_CONTAINER_NAME=yeswesync-staging-db

STAGING_USER=staging
STAGING_PASSWORD=CHANGE_ME_STAGING_PASSWORD
STAGING_DB=yeswesync_staging

# Port d'écoute sur l'hôte (accessible depuis YesWeReport)
STAGING_PORT=5433

# ── Variables à configurer dans YesWeReport ───────────────────────────────────

# Depuis YesWeReport (même Droplet) :
# AIRBYTE_STAGING_DATABASE_URL=postgresql://staging:PASSWORD@localhost:5433/yeswesync_staging

# Depuis YesWeReport (Droplet séparé) :
# AIRBYTE_STAGING_DATABASE_URL=postgresql://staging:PASSWORD@IP_PRIVEE_DROPLET:5433/yeswesync_staging
