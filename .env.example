# YesWeSync / Airbyte 2.2.0 — Variables d'environnement
# Copier ce fichier en .env (local) ou saisir dans Coolify.
# AUCUN secret réel dans ce fichier.

# ── A. Airbyte core ────────────────────────────────────────────────────────────
AIRBYTE_VERSION=2.2.0

# Méthode de stockage des secrets Airbyte
# Options: TESTING_CONFIG_DB_SECRET (simple) | GOOGLE_SECRET_MANAGER | VAULT | AWS_SECRET_MANAGER
SECRET_PERSISTENCE=TESTING_CONFIG_DB_SECRET

# Stratégie de tracking (logging = local seulement, pas d'envoi chez Airbyte)
TRACKING_STRATEGY=logging

# Rôle de l'instance
AIRBYTE_ROLE=community

# URL publique de l'application (domaine Coolify, avec https)
WEBAPP_URL=https://yeswesync.VOTRE_DOMAINE.com

# Niveau de log (DEBUG | INFO | WARN | ERROR)
LOG_LEVEL=INFO

# Environnement des workers
WORKER_ENVIRONMENT=docker

# Auto-détection du schéma
AUTO_DETECT_SCHEMA=true

# ── B. Airbyte metadata PostgreSQL (base interne Airbyte) ─────────────────────
# NE PAS utiliser pour YesWeReport — usage Airbyte uniquement
DATABASE_USER=airbyte
DATABASE_PASSWORD=CHANGE_ME_AIRBYTE_DB_PASSWORD
DATABASE_DB=airbyte
DATABASE_HOST=db
DATABASE_PORT=5432

# ── C. Authentification de base (Basic Auth sur le proxy Airbyte) ─────────────
BASIC_AUTH_USERNAME=yeswesync
BASIC_AUTH_PASSWORD=CHANGE_ME_BASIC_AUTH_PASSWORD
BASIC_AUTH_PROXY_TIMEOUT=900

# ── D. Ports exposés ──────────────────────────────────────────────────────────
# Port principal (HTTP, géré par Coolify reverse proxy)
PROXY_PORT=8000
# Port HTTPS interne proxy (si Coolify gère le TLS, laisser 8443)
PROXY_HTTPS_PORT=8443

# ── E. Staging PostgreSQL (destination syncs → YesWeReport) ───────────────────
# Cette base est celle qu'Airbyte utilisera comme DESTINATION
# et que YesWeReport lira comme SOURCE de données
STAGING_USER=staging
STAGING_PASSWORD=CHANGE_ME_STAGING_PASSWORD
STAGING_DB=yeswesync_staging

# URL à fournir à YesWeReport pour lire les données de staging
# Format : postgresql://USER:PASSWORD@HOST:PORT/DB
AIRBYTE_STAGING_DATABASE_URL=postgresql://staging:CHANGE_ME_STAGING_PASSWORD@staging-db:5432/yeswesync_staging
