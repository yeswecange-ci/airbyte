# YesWeSync / Airbyte 2.2.0 — Variables d'environnement
# Copier dans Coolify → Environment Variables
# AUCUN secret réel dans ce fichier.

# ── Infrastructure / Airbyte ───────────────────────────────────────────────────

# URL publique d'Airbyte (domaine Coolify avec https)
AIRBYTE_URL=https://yeswesync.VOTRE_DOMAINE.com

# Port HTTP sur lequel abctl/kind expose Airbyte sur l'hôte DigitalOcean
# Ce port est celui que Coolify reverse proxy doit cibler (localhost:AIRBYTE_PORT)
AIRBYTE_PORT=8085

# Mot de passe de l'utilisateur admin initial Airbyte
AIRBYTE_INITIAL_USER_PASSWORD=CHANGE_ME_AIRBYTE_ADMIN_PASSWORD

# ID d'installation unique (laisser vide pour auto-générer au 1er lancement)
AIRBYTE_INSTALLATION_ID=

# ── Ressources des jobs Airbyte (connecteurs) ─────────────────────────────────
AIRBYTE_JOB_CPU_LIMIT=3
AIRBYTE_JOB_MEMORY_LIMIT=4Gi

# Flags additionnels abctl (ex: --low-resource-mode pour Droplets < 8 Go RAM)
# Laisser vide sur un Droplet standard (8 Go+)
ABCTL_EXTRA_FLAGS=

# ── Staging PostgreSQL (destination syncs → YesWeReport) ──────────────────────
# SÉPARÉE de la DB metadata Airbyte (gérée en interne par abctl/kind)
STAGING_USER=staging
STAGING_PASSWORD=CHANGE_ME_STAGING_PASSWORD
STAGING_DB=yeswesync_staging

# Port d'écoute du staging sur localhost du Droplet
# Utiliser un port différent de 5432 pour éviter les conflits
STAGING_PORT=5433

# ── Variable à configurer dans YesWeReport ────────────────────────────────────
# URL que YesWeReport utilise pour lire les données de staging
AIRBYTE_STAGING_DATABASE_URL=postgresql://staging:CHANGE_ME_STAGING_PASSWORD@localhost:5433/yeswesync_staging
